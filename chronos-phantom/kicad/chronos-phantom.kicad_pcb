    (property "Description" "IEEE 802.3af PoE PD controller — power from inline Ethernet")
    (property "Author" "jayis1")
    (pad "1" smd rect (at -2.25 -2 0) (size 0.25 0.6) (layers "F.Cu" "F.Paste" "F.Mask") (net 5 "VPOE")))

  (footprint "Package_LGA:LGA-14_3x2.5mm_P0.5mm"
