  (footprint "Package_QFN:QFN-32-1EP_5x5mm_P0.5mm_EP3.6x3.6mm"
    (layer "F.Cu")
    (at 5 8 0)
    (property "Reference" "U7")
    (property "Value" "Si3402-B")
    (property "Footprint" "Package_QFN:QFN-32-1EP_5x5mm_P0.5mm_EP3.6x3.6mm")
