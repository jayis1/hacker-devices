    (pad "2" smd rect (at 2 0 0) (size 2 2.5) (layers "F.Cu" "F.Paste" "F.Mask")))

  ; Ground plane vias (placement markers)
  (via (at 5 5) (size 0.3) (drill 0.2) (layers "F.Cu" "B.Cu") (net 1 "GND"))
  (via (at 60 5) (size 0.3) (drill 0.2) (layers "F.Cu" "B.Cu") (net 1 "GND"))
  (via (at 5 25) (size 0.3) (drill 0.2) (layers "F.Cu" "B.Cu") (net 1 "GND"))
  (via (at 60 25) (size 0.3) (drill 0.2) (layers "F.Cu" "B.Cu") (net 1 "GND"))
  (via (at 32.5 15) (size 0.3) (drill 0.2) (layers "F.Cu" "B.Cu") (net 1 "GND"))

  ; Zone fills (GND)
  (zone (net 1) (net_name "GND") (layer "F.Cu") (tstamp 0)
    (connect_pads (clearance 0.2))
    (min_thickness 0.15)
    (fill yes (thermal_gap 0.2) (thermal_bridge_width 0.3))
    (polygon
      (pts
        (xy 0 0)
        (xy 65 0)
        (xy 65 30)
        (xy 0 30))))
  (zone (net 1) (net_name "GND") (layer "B.Cu") (tstamp 1)
    (connect_pads (clearance 0.2))
    (min_thickness 0.15)
    (fill yes (thermal_gap 0.2) (thermal_bridge_width 0.3))
    (polygon
      (pts
        (xy 0 0)
        (xy 65 0)
        (xy 65 30)
        (xy 0 30))))
)

