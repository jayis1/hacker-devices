(kicad_pcb
  (version 20230630)
  (generator "chronos-phantom-pcb")
  (generator_version "1.0")
  (general
    (thickness 1.6)
    (legacy_teardrops no))
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (1 "In1.Cu" signal)
    (2 "In2.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user "User.Drawings")
    (41 "Cmts.User" user "User.Comments")
    (42 "Eco1.User" user "User.Eco1")
    (43 "Eco2.User" user "User.Eco2")
    (44 "Edge.Cuts" user)
    (45 "Margin" user)
    (46 "B.CrtYd" user "B.Courtyard")
    (47 "F.CrtYd" user "F.Courtyard")
    (48 "B.Fab" user)
    (49 "F.Fab" user))
  (setup
    (stackup
      (layer "F.SilkS" (type "Top Silk Screen"))
      (layer "F.Paste" (type "Top Solder Paste"))
      (layer "F.Mask" (type "Top Solder Mask") (color "Black"))
      (layer "F.Cu" (type "copper") (thickness 0.035))
      (layer "dielectric 1" (type "core") (thickness 0.2) (material "FR4"))
      (layer "In1.Cu" (type "copper") (thickness 0.035))
      (layer "dielectric 2" (type "prepreg") (thickness 0.7) (material "FR4"))
      (layer "In2.Cu" (type "copper") (thickness 0.035))
      (layer "dielectric 3" (type "core") (thickness 0.2) (material "FR4"))
      (layer "B.Cu" (type "copper") (thickness 0.035))
      (layer "B.Mask" (type "Bottom Solder Mask") (color "Black"))
      (layer "B.Paste" (type "Bottom Solder Paste"))
      (layer "B.SilkS" (type "Bottom Silk Screen"))
      (copper_finish "ENIG")
      (thickness 1.6))
    (pad_to_mask_clearance 0.05)
    (pcbplotparams
      (layerselection 0x0001000_7fffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
      (excludeedgelayers true)
      (plotframeref false)
      (useauxorigin false)
      (hpgnpen 0)
      (psnegative false)
      (psa4output false)
      (plotreference true)
      (plotvalue true)
      (plotfptext false)
      (plotinvisibletext false)
      (padsonsilk false)
      (subtractmaskfromsilk true))
    (aux_axis_origin 0 0))
  (net 0 "")
  (net 1 "GND")
  (net 2 "+3V3")
  (net 3 "+5V")
  (net 4 "VBUS")
  (net 5 "VPOE")
  (net 6 "VBAT")
  (net 7 "NET_TXP")
  (net 8 "NET_TXM")
  (net 9 "NET_RXP")
  (net 10 "NET_RXM")
  (net 11 "MDIO")
  (net 12 "MDC")
  (net 13 "ETH_RSTn")
  (net 14 "ETH_NRST")
  (net 15 "RMII_TXD0")
  (net 16 "RMII_TXD1")
  (net 17 "RMII_TXEN")
  (net 18 "RMII_RXD0")
  (net 19 "RMII_RXD1")
  (net 20 "RMII_CRS_DV")
  (net 21 "RMII_REF_CLK")
  (net 22 "NRST")
  (net 23 "BOOT0")
  (net 24 "SWDIO")
  (net 25 "SWCLK")
  (net 26 "TRACECLK")
  (net 27 "UART_TX_BLE")
  (net 28 "UART_RX_BLE")
  (net 29 "GNSS_TX")
  (net 30 "GNSS_RX")
  (net 31 "GNSS_PPS")
  (net 32 "GNSS_PWR")
  (net 33 "I2C2_SCL")
  (net 34 "I2C2_SDA")
  (net 35 "DAC1_OUT")
  (net 36 "LED1_PWM")
  (net 37 "LED2_PWM")
  (net 38 "LED3_PWM")
  (net 39 "LED4_PWM")
  (net 40 "MODE_BTN")
  (net 41 "IMU_INT1")
  (net 42 "IMU_INT2")
  (net 43 "USB_DP")
  (net 44 "USB_DM")
  (net 45 "SPI3_NSS")
  (net 46 "SPI3_SCK")
  (net 47 "SPI3_MISO")
  (net 48 "SPI3_MOSI")

  ; ------------------------------------------------------------------
  ;  Board outline (65 x 30 mm)
  ; ------------------------------------------------------------------
  (gr_line (start 0 0) (end 65 0)
    (stroke (width 0.15) (type solid)) (layer "Edge.Cuts"))
  (gr_line (start 65 0) (end 65 30)
    (stroke (width 0.15) (type solid)) (layer "Edge.Cuts"))
  (gr_line (start 65 30) (end 0 30)
    (stroke (width 0.15) (type solid)) (layer "Edge.Cuts"))
  (gr_line (start 0 30) (end 0 0)
    (stroke (width 0.15) (type solid)) (layer "Edge.Cuts"))

  (gr_text "Chronos-Phantom  |  IEEE 1588 PTP Attack  |  jayis1  |  CERN-OHL-S v2"
    (at 32.5 28) (layer "B.SilkS")
    (effects (font (size 0.8 0.6) (thickness 0.1))))

  ; ------------------------------------------------------------------
  ;  Footprints (placement on F.Cu)
  ; ------------------------------------------------------------------
  (footprint "Package_QFP:LQFP-100_14x14mm_P0.5mm"
    (layer "F.Cu")
    (at 25 15 0)
    (property "Reference" "U1")
    (property "Value" "STM32H753VIT6")
    (property "Footprint" "Package_QFP:LQFP-100_14x14mm_P0.5mm")
    (property "Datasheet" "https://www.st.com/resource/en/datasheet/stm32h753vi.pdf")
    (property "Description" "ARM Cortex-M7 MCU 480MHz 2MB Flash 1MB RAM — main processor")
    (property "Author" "jayis1")
    (pad "1" smd roundrect (at -7 -6 0) (size 0.2 1.5) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25) (net 2 "+3V3")))

  (footprint "Package_DFN_QFN:QFN-48-1EP_7x7mm_P0.5mm_EP4x4mm"
    (layer "F.Cu")
    (at 10 10 0)
    (property "Reference" "U2")
    (property "Value" "KSZ9131RNI")
    (property "Footprint" "Package_DFN_QFN:QFN-48-1EP_7x7mm_P0.5mm_EP4x4mm")
    (property "Datasheet" "https://www.microchip.com/wwwproducts/en/KSZ9131")
    (property "Description" "10/100/1000BASE-T RGMII PHY with IEEE 1588v2 PTP hardware timestamping")
    (property "Author" "jayis1")
    (pad "1" smd roundrect (at -3.25 -3 0) (size 0.25 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25) (net 3 "+3V3")))

  (footprint "Package_DFN_QFN:QFN-32-1EP_5x5mm_P0.5mm_EP3.6x3.6mm"
    (layer "F.Cu")
    (at 50 8 0)
    (property "Reference" "U3")
    (property "Value" "ESP32-C3FH4")
    (property "Footprint" "Package_DFN_QFN:QFN-32-1EP_5x5mm_P0.5mm_EP3.6x3.6mm")
    (property "Datasheet" "https://www.espressif.com/sites/default/files/documentation/esp32-c3_datasheet_en.pdf")
    (property "Description" "RISC-V SoC with BLE 5.0 — operator control link")
    (property "Author" "jayis1")
    (pad "1" smd roundrect (at -2.25 -2 0) (size 0.25 0.6) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25) (net 2 "+3V3")))

  (footprint "Oscillator:Oscillator_DIP-14_W7.0mm_H8.0mm"
    (layer "F.Cu")
    (at 40 22 0)
    (property "Reference" "U4")
    (property "Value" "MV89-10MHz-VC-TCXO")
    (property "Footprint" "Oscillator:Oscillator_DIP-14_W7.0mm_H8.0mm")
    (property "Datasheet" "https://www.morion.com.ru/products/119")
    (property "Description" "Voltage-controlled TCXO 10 MHz ±0.5 ppb — local time reference")
    (property "Author" "jayis1")
    (pad "1" thru_hole rect (at -5.08 -2.54 0) (size 1.6 1.6) (drill 0.8) (layers "*.Cu" "*.Mask") (net 35 "DAC1_OUT")))

  (footprint "Package_LCC:LCC-36_9x9mm_P1.27mm"
    (layer "F.Cu")
    (at 55 22 0)
    (property "Reference" "U5")
    (property "Value" "NEO-M9N")
    (property "Footprint" "Package_LCC:LCC-36_9x9mm_P1.27mm")
    (property "Datasheet" "https://www.u-blox.com/en/docs/UBX-19109412")
    (property "Description" "u-blox GNSS receiver (GPS/Galileo/GLONASS) — optional external time reference")
    (property "Author" "jayis1")
    (pad "1" smd rect (at -4 -3.81 0) (size 1.6 0.6) (layers "F.Cu" "F.Paste" "F.Mask") (net 2 "+3V3")))

  (footprint "Package_SON:SON-10_3x3mm_P0.5mm"
    (layer "F.Cu")
    (at 5 22 0)
    (property "Reference" "U6")
    (property "Value" "TPS63031")
    (property "Footprint" "Package_SON:SON-10_3x3mm_P0.5mm")
    (property "Datasheet" "https://www.ti.com/lit/ds/symlink/tps63031.pdf")
