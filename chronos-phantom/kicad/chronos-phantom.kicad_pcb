    (pad "1" smd rect (at -4 0 0) (size 1.5 1.5) (layers "F.Cu" "F.Paste" "F.Mask") (net 7 "NET_TXP")))

  (footprint "Connector_USB:USB_C_Receptacle_HRO_TYPE-C-31-M-12"
    (layer "F.Cu")
    (at 33 2 0)
    (property "Reference" "J3")
    (property "Value" "USB-C")
    (property "Footprint" "Connector_USB:USB_C_Receptacle_HRO_TYPE-C-31-M-12")
    (property "Datasheet" "https://www.usb.org/sites/default/files/docs/USB_C-31-M-12.pdf")
