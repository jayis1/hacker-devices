      {"name": "WQFN-14-1EP_2.8x2.8mm_P0.4mm", "lib": "Package_DFN_QFN"},
      {"name": "QFN-24-1EP_4x4mm_P0.5mm", "lib": "Package_DFN_QFN"},
      {"name": "VSSOP-10_3x3mm_P0.5mm", "lib": "Package_SO"},
      {"name": "NINA-B3", "lib": "RF_Module"},
      {"name": "QFN-16-1EP_3x3mm_P0.4mm", "lib": "Package_DFN_QFN"},
      {"name": "MSOP-10_3x3mm_P0.5mm", "lib": "Package_SO"},
      {"name": "TSSOP-8_3x3mm_P0.65mm", "lib": "Package_TO_SOT_SMD"},
      {"name": "SOT-23-5", "lib": "Package_TO_SOT_SMD"},
      {"name": "PowerPAK_SO-8_Single", "lib": "Package_SO"},
      {"name": "USB_C_Receptacle_HRO_TYPE-C-31-M-12", "lib": "Connector_USB"},
      {"name": "OLED_128x64_0.96in", "lib": "Display"},
      {"name": "C_0402_1005Metric", "lib": "Capacitor_SMD"},
      {"name": "C_0805_2012Metric", "lib": "Capacitor_SMD"},
      {"name": "LED_0603_1608Metric", "lib": "LED_SMD"}
    ]
  },
