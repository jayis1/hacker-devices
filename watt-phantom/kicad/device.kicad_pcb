    (rev "1.0")
    (company "jayis1")
    (comment 1 "Author: jayis1")
    (comment 2 "License: CERN-OHL-S v2")
    (comment 3 "55x22mm, 6-layer, USB 2.0 controlled impedance")
  )

  (layers
    (0 "F.Cu" signal)
    (1 "In1.Cu" signal "GND")
    (2 "In2.Cu" signal "PWR")
    (3 "In3.Cu" signal "AGND")
    (4 "In4.Cu" signal "VBUS")
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
