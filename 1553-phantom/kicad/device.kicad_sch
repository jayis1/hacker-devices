  ; ---- Net connections (the netlist) ----
  ; Format: (net (code N) (name "...") (node ref pin)...)
  (nets

    (net (code 1) (name "GND")
      (node "U1" "VSS") (node "U2" "GND") (node "U3" "GND") (node "U4" "GND")
      (node "U5" "GND") (node "U6" "GND") (node "U7" "GND") (node "U8" "GND")
      (node "U9" "GND") (node "J3" "GND") (node "J4" "2") (node "J1" "SHIELD")
      (node "J2" "SHIELD") (node "BT1" "-")
    )

    (net (code 2) (name "VBUS")
      (node "J3" "VBUS") (node "U6" "VCC") (node "U8" "IN") (node "J4" "1")
      (node "LED1" "A") (node "U6" "PROG")
    )

    (net (code 3) (name "+3V3")
      (node "U1" "VDD") (node "U2" "VCCIO") (node "U3" "VCC") (node "U4" "VCC")
      (node "U5" "VCC") (node "U7" "VCC") (node "U8" "OUT")
      (node "LED2" "A") (node "LED3" "A") (node "LED4" "A")
    )

    (net (code 4) (name "+1V2")
      (node "U2" "VCC") (node "U9" "OUT")
    )

    (net (code 5) (name "+BATT")
      (node "BT1" "+") (node "U6" "BAT") (node "U7" "CELL")
    )

    ; ---- 1553 channel A (primary) ----
    (net (code 10) (name "1553A_HI")
      (node "J1" "1") (node "U3" "TX_A_HI") (node "U3" "RX_A_HI")
    )
    (net (code 11) (name "1553A_LO")
      (node "J1" "2") (node "U3" "TX_A_LO") (node "U3" "RX_A_LO")
    )
    (net (code 12) (name "1553A_SHLD")
      (node "J1" "3") (node "J1" "SHIELD")
    )

    ; ---- 1553 channel B (redundant) ----
    (net (code 20) (name "1553B_HI")
      (node "J2" "1") (node "U4" "TX_A_HI") (node "U4" "RX_A_HI")
    )
    (net (code 21) (name "1553B_LO")
      (node "J2" "2") (node "U4" "TX_A_LO") (node "U4" "RX_A_LO")
    )
    (net (code 22) (name "1553B_SHLD")
      (node "J2" "3") (node "J2" "SHIELD")
    )

    ; ---- SPI MCU <-> FPGA ----
    (net (code 30) (name "SPI_SCK")
      (node "U1" "PA5") (node "U2" "SCK")
    )
    (net (code 31) (name "SPI_MISO")
      (node "U1" "PA6") (node "U2" "SDO")
    )
    (net (code 32) (name "SPI_MOSI")
      (node "U1" "PA7") (node "U2" "SDI")
    )
    (net (code 33) (name "FPGA_CS")
      (node "U1" "PA4") (node "U2" "CSN")
    )
    (net (code 34) (name "FPGA_IRQ")
      (node "U1" "PA11") (node "U2" "IRQ_N")
    )
    (net (code 35) (name "FPGA_RST")
      (node "U1" "PA12") (node "U2" "CRESET_N")
    )
    (net (code 36) (name "FPGA_CDONE")
      (node "U1" "PB5") (node "U2" "CDONE")
    )

    ; ---- FPGA <-> HI-1573 transceivers ----
    (net (code 40) (name "FPGA_TX0_P")
      (node "U2" "IO_0") (node "U3" "TX_IN_A")
    )
    (net (code 41) (name "FPGA_TX0_N")
      (node "U2" "IO_1") (node "U3" "TX_IN_B")
    )
    (net (code 42) (name "FPGA_RX0_P")
      (node "U2" "IO_2") (node "U3" "RX_OUT_A")
    )
    (net (code 43) (name "FPGA_RX0_N")
      (node "U2" "IO_3") (node "U3" "RX_OUT_B")
    )
    (net (code 44) (name "FPGA_TX1_P")
      (node "U2" "IO_4") (node "U4" "TX_IN_A")
    )
    (net (code 45) (name "FPGA_TX1_N")
      (node "U2" "IO_5") (node "U4" "TX_IN_B")
    )
    (net (code 46) (name "FPGA_RX1_P")
      (node "U2" "IO_6") (node "U4" "RX_OUT_A")
    )
    (net (code 47) (name "FPGA_RX1_N")
      (node "U2" "IO_7") (node "U4" "RX_OUT_B")
    )
    (net (code 48) (name "TX_GATE")
      (node "U1" "PB11") (node "U3" "TX_EN") (node "U4" "TX_EN")
    )

    ; ---- USB ----
    (net (code 50) (name "USB_DM")
      (node "U1" "PA8") (node "J3" "D-")
    )
    (net (code 51) (name "USB_DP")
      (node "U1" "PA9") (node "J3" "D+")
    )

    ; ---- OLED ----
    (net (code 60) (name "OLED_DC")
      (node "U1" "PA0") (node "U5" "DC")
    )
    (net (code 61) (name "OLED_RST")
      (node "U1" "PA1") (node "U5" "RES")
    )
    (net (code 62) (name "OLED_CS")
      (node "U1" "PC13") (node "U5" "CS")
    )
    ; OLED SCK/MOSI share SPI1 with FPGA (different CS)
    (net (code 63) (name "OLED_SCK")
      (node "U1" "PA5") (node "U5" "SCK")
    )
    (net (code 64) (name "OLED_MOSI")
      (node "U1" "PA7") (node "U5" "SDA")
    )

    ; ---- I2C fuel gauge ----
    (net (code 70) (name "I2C_SCL")
      (node "U1" "PB8") (node "U7" "SCL")
    )
    (net (code 71) (name "I2C_SDA")
      (node "U1" "PB9") (node "U7" "SDA")
    )

    ; ---- User button + panic ----
    (net (code 80) (name "USER_BTN")
      (node "U1" "PA10") (node "SW1" "1")
    )
    (net (code 81) (name "PANIC")
      (node "U1" "PB10") (node "SW1" "2")
    )

    ; ---- LEDs ----
    (net (code 90) (name "LED_PWR")
      (node "U1" "PA15") (node "LED1" "K")
    )
    (net (code 91) (name "LED_ACTA")
      (node "U1" "PB0") (node "LED2" "K")
    )
    (net (code 92) (name "LED_ACTB")
      (node "U1" "PB1") (node "LED3" "K")
    )
    (net (code 93) (name "LED_ARM")
      (node "U1" "PB3") (node "LED4" "K1")
    )
    (net (code 94) (name "LED_INJ")
      (node "U1" "PB4") (node "LED4" "K2")
    )

    ; ---- Crystals ----
    (net (code 100) (name "OSC_IN")
      (node "U1" "PD0") (node "Y1" "1")
    )
    (net (code 101) (name "OSC_OUT")
      (node "U1" "PD1") (node "Y1" "2")
    )
    (net (code 102) (name "FPGA_CLK")
      (node "U2" "CLK") (node "Y2" "1")
    )
  )

  ; ---- Buses / graphical notes ----
  (bus_entry (bus "1553A") (members "1553A_HI" "1553A_LO" "1553A_SHLD"))
  (bus_entry (bus "1553B") (members "1553B_HI" "1553B_LO" "1553B_SHLD"))
  (bus_entry (bus "SPI") (members "SPI_SCK" "SPI_MISO" "SPI_MOSI" "FPGA_CS"))

  ; ---- Power flags ----
  (power "GND" (net 1))
  (power "+3V3" (net 3))
  (power "+1V2" (net 4))
  (power "VBUS" (net 2))

  ; ---- Sheet text ----
  (text (at 20 20) "1553-Phantom top-level schematic\nAuthor: jayis1\nLicense: CERN-OHL-S v2"
    (effects (font (size 2 2))))

  ; ---- Hierarchical labels (single sheet, no sub-sheets) ----
  (label "1553A_HI" (at 0 0))
  (label "1553A_LO" (at 0 0))
  (label "1553B_HI" (at 0 0))
  (label "1553B_LO" (at 0 0))
  (label "SPI_SCK" (at 0 0))
  (label "SPI_MISO" (at 0 0))
  (label "SPI_MOSI" (at 0 0))

  ; ---- Connection wires (subset; full routing in PCB) ----
  (wire (pts (xy 0 0) (xy 1 1)) (net "GND"))
  (wire (pts (xy 0 0) (xy 1 1)) (net "VBUS"))
  (wire (pts (xy 0 0) (xy 1 1)) (net "+3V3"))
  (wire (pts (xy 0 0) (xy 1 1)) (net "1553A_HI"))
  (wire (pts (xy 0 0) (xy 1 1)) (net "1553B_HI"))

  ; ---- No-ERC markers on unused MCU pins ----
  (no_connect (at 0 0) (uuid "nc-0001"))

