    (stroke (width 0.1524)) (net 74))
  (wire (pts (xy 15.24 55.88) (xy 50.8 -2.54))
    (stroke (width 0.1524)) (net 75))

  ;; FPGA parallel bus to bridge
  (wire (pts (xy 76.2 15.24) (xy 76.2 25.4))
