  /* ============================================================
   * NETS AND CONNECTIONS
   * ============================================================ */

  /* Power nets */
  (net (code 1) (name "+3V3"))
  (net (code 2) (name "GND"))
  (net (code 3) (name "VBAT"))
  (net (code 4) (name "VBUS"))

  /* nRF52840 to FPGA SPI */
  (net (code 10) (name "FPGA_SCK"))
  (net (code 11) (name "FPGA_MOSI"))
  (net (code 12) (name "FPGA_MISO"))
  (net (code 13) (name "FPGA_CSN"))
  (net (code 14) (name "FPGA_CDONE"))
  (net (code 15) (name "FPGA_CRSTB"))

  /* nRF52840 to ESP32-S3 SPI */
  (net (code 20) (name "DSP_SCK"))
  (net (code 21) (name "DSP_MOSI"))
  (net (code 22) (name "DSP_MISO"))
  (net (code 23) (name "DSP_CSN"))
  (net (code 24) (name "DSP_HANDSHAKE"))
  (net (code 25) (name "DSP_RESET"))

  /* QSPI bus (shared PSRAM + Flash) */
