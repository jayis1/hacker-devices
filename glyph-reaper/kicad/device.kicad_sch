  (net (code 31) (name "QSPI_IO0"))
  (net (code 32) (name "QSPI_IO1"))
  (net (code 33) (name "QSPI_IO2"))
  (net (code 34) (name "QSPI_IO3"))
  (net (code 35) (name "QSPI_CSN_PSRAM"))
  (net (code 36) (name "QSPI_CSN_FLASH"))

  /* I2C bus (accelerometer) */
