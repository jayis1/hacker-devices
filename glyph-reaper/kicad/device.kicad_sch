  (net (code 51) (name "FRAME_D1"))
  (net (code 52) (name "FRAME_D2"))
  (net (code 53) (name "FRAME_D3"))
  (net (code 54) (name "FRAME_D4"))
  (net (code 55) (name "FRAME_D5"))
  (net (code 56) (name "FRAME_D6"))
  (net (code 57) (name "FRAME_D7"))
  (net (code 58) (name "FRAME_HSYNC"))
  (net (code 59) (name "FRAME_VSYNC"))
  (net (code 60) (name "FRAME_PCLK"))
  (net (code 61) (name "FRAME_DE"))

  /* LED and button nets */
