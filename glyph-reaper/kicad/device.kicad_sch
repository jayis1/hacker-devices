  (net (code 91) (name "DISP_CLK_N"))
  (net (code 92) (name "DISP_DATA0_P"))
  (net (code 93) (name "DISP_DATA0_N"))
  (net (code 94) (name "DISP_DATA1_P"))
  (net (code 95) (name "DISP_DATA1_N"))
  (net (code 96) (name "DISP_DATA2_P"))
  (net (code 97) (name "DISP_DATA2_N"))
  (net (code 98) (name "DISP_DATA3_P"))
  (net (code 99) (name "DISP_DATA3_N"))

