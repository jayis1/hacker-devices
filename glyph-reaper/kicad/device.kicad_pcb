    (property "Reference" "C3" (at 0 -1 0))
    (property "Value" "100nF" (at 0 1 0))
    (property "Author" "jayis1")
    (pad "1" smd rect (at -0.5 0) (size 0.5 0.5) (layers "F.Cu" "F.Paste" "F.Mask") (net 1))
    (pad "2" smd rect (at 0.5 0) (size 0.5 0.5) (layers "F.Cu" "F.Paste" "F.Mask") (net 2))
  )

  (footprint "Capacitor_SMD:C_0402_1005Metric"
    (layer "F.Cu")
    (at 7 6)
    (property "Reference" "C4" (at 0 -1 0))
    (property "Value" "4.7uF" (at 0 1 0))
    (property "Author" "jayis1")
    (pad "1" smd rect (at -0.5 0) (size 0.5 0.5) (layers "F.Cu" "F.Paste" "F.Mask") (net 1))
    (pad "2" smd rect (at 0.5 0) (size 0.5 0.5) (layers "F.Cu" "F.Paste" "F.Mask") (net 2))
  )

  (footprint "Capacitor_SMD:C_0402_1005Metric"
    (layer "F.Cu")
    (at 8 6)
    (property "Reference" "C5" (at 0 -1 0))
    (property "Value" "10uF" (at 0 1 0))
    (property "Author" "jayis1")
    (pad "1" smd rect (at -0.5 0) (size 0.5 0.5) (layers "F.Cu" "F.Paste" "F.Mask") (net 1))
    (pad "2" smd rect (at 0.5 0) (size 0.5 0.5) (layers "F.Cu" "F.Paste" "F.Mask") (net 2))
  )

  /* Crystal Y1 — 32 MHz */
  (footprint "Crystal:Crystal_SMD_2016-2Pin_2.0x1.6mm"
    (layer "F.Cu")
    (at 8 10)
    (property "Reference" "Y1" (at 0 -2 0))
    (property "Value" "32MHz" (at 0 2 0))
    (property "Author" "jayis1")
    (pad "1" smd rect (at -0.8 0) (size 0.8 0.6) (layers "F.Cu" "F.Paste" "F.Mask") (net 0))
    (pad "2" smd rect (at 0.8 0) (size 0.8 0.6) (layers "F.Cu" "F.Paste" "F.Mask") (net 0))
  )

  /* Crystal Y2 — 32.768 kHz */
  (footprint "Crystal:Crystal_SMD_3215-2Pin_3.2x1.5mm"
    (layer "F.Cu")
    (at 14 3)
    (property "Reference" "Y2" (at 0 -2 0))
    (property "Value" "32.768kHz" (at 0 2 0))
    (property "Author" "jayis1")
    (pad "1" smd rect (at -1.2 0) (size 1.0 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 0))
    (pad "2" smd rect (at 1.2 0) (size 1.0 0.8) (layers "F.Cu" "F.Paste" "F.Mask") (net 0))
  )

  /* Battery holder */
  (footprint "Battery:BatteryHolder_Keystone_3002_1x2032"
    (layer "F.Cu")
    (at 3 3)
    (property "Reference" "BT1" (at 0 -12 0))
    (property "Value" "CR2032" (at 0 12 0))
    (property "Author" "jayis1")
    (pad "1" smd rect (at 0 -8) (size 5 5) (layers "F.Cu" "F.Paste" "F.Mask") (net 3))
    (pad "2" smd rect (at 0 8) (size 5 5) (layers "F.Cu" "F.Paste" "F.Mask") (net 2))
  )

  /* ============================================================
   * BOARD OUTLINE — 22mm x 18mm flexible PCB
   * ============================================================ */
  (gr_line (start 0 0) (end 22 0) (stroke (width 0.1)) (layer "Edge.Cuts"))
  (gr_line (start 22 0) (end 22 18) (stroke (width 0.1)) (layer "Edge.Cuts"))
  (gr_line (start 22 18) (end 0 18) (stroke (width 0.1)) (layer "Edge.Cuts"))
  (gr_line (start 0 18) (end 0 0) (stroke (width 0.1)) (layer "Edge.Cuts"))

  /* Board identification text */
  (gr_text "GLYPH-REAPER Rev A" (at 11 1) (layer "F.SilkS") (effects (font (size 0.8 0.8))))
  (gr_text "jayis1 2026" (at 11 17.5) (layer "F.SilkS") (effects (font (size 0.6 0.6))))
  (gr_text "22x18mm Flex" (at 1 17.5) (layer "F.SilkS") (effects (font (size 0.5 0.5))))

  /* ============================================================
   * ZONES — Ground plane on inner layers
   * ============================================================ */
  (zone (net 2) (net_name "GND") (layer "In2.Cu") (tstamp 0)
    (hatch edge 0.2)
    (connect_pads (clearance 0.1))
    (min_thickness 0.1)
    (fill yes (thermal_gap 0.15) (thermal_bridge_width 0.2))
    (polygon (pts (xy 0.1 0.1) (xy 21.9 0.1) (xy 21.9 17.9) (xy 0.1 17.9)))
  )

  (zone (net 2) (net_name "GND") (layer "B.Cu") (tstamp 1)
    (hatch edge 0.2)
    (connect_pads (clearance 0.1))
    (min_thickness 0.1)
    (fill yes (thermal_gap 0.15) (thermal_bridge_width 0.2))
    (polygon (pts (xy 0.1 0.1) (xy 21.9 0.1) (xy 21.9 17.9) (xy 0.1 17.9)))
  )

  /* ============================================================
   * ROUTES — Key signal traces (representative)
   * ============================================================ */

  /* QSPI clock and data lines (50 ohm impedance on In1.Cu) */
  (segment (start 5.7 12.365) (end 7.5 12.365) (width 0.15) (layer "In1.Cu") (net 30))
  (segment (start 5.7 13.095) (end 7.5 13.095) (width 0.15) (layer "In1.Cu") (net 31))
  (segment (start 5.7 11.365) (end 7.5 11.365) (width 0.15) (layer "In1.Cu") (net 32))
  (segment (start 5.7 10.365) (end 7.5 10.365) (width 0.15) (layer "In1.Cu") (net 33))
  (segment (start 5.7 14.365) (end 7.5 14.365) (width 0.15) (layer "In1.Cu") (net 34))

  /* FPGA SPI lines (routed on F.Cu) */
  (segment (start 7.5 5.75) (end 9 7.25) (width 0.15) (layer "F.Cu") (net 10))
  (segment (start 7.5 6.25) (end 9 7.75) (width 0.15) (layer "F.Cu") (net 11))
  (segment (start 7.5 6.75) (end 9 8.25) (width 0.15) (layer "F.Cu") (net 12))
  (segment (start 7.5 7.25) (end 9 8.75) (width 0.15) (layer "F.Cu") (net 13))

  /* Display bus differential pairs (F.Cu, 90 ohm differential) */
  (segment (start 16.4 10) (end 15 10) (width 0.12) (layer "F.Cu") (net 90))
  (segment (start 16.4 10.4) (end 15 10.4) (width 0.12) (layer "F.Cu") (net 91))
  (segment (start 16.4 9.6) (end 15 9.6) (width 0.12) (layer "F.Cu") (net 92))
  (segment (start 16.4 9.2) (end 15 9.2) (width 0.12) (layer "F.Cu") (net 93))

  /* Vias for layer transitions */
  (via (at 6 6) (size 0.3) (drill 0.15) (layers "F.Cu" "B.Cu") (net 2))
  (via (at 9 6) (size 0.3) (drill 0.15) (layers "F.Cu" "B.Cu") (net 2))
  (via (at 12 6) (size 0.3) (drill 0.15) (layers "F.Cu" "B.Cu") (net 2))
  (via (at 15 6) (size 0.3) (drill 0.15) (layers "F.Cu" "B.Cu") (net 2))
  (via (at 18 6) (size 0.3) (drill 0.15) (layers "F.Cu" "B.Cu") (net 2))
  (via (at 6 12) (size 0.3) (drill 0.15) (layers "F.Cu" "B.Cu") (net 2))
  (via (at 9 12) (size 0.3) (drill 0.15) (layers "F.Cu" "B.Cu") (net 2))
  (via (at 12 12) (size 0.3) (drill 0.15) (layers "F.Cu" "B.Cu") (net 2))
  (via (at 15 12) (size 0.3) (drill 0.15) (layers "F.Cu" "B.Cu") (net 2))
  (via (at 18 12) (size 0.3) (drill 0.15) (layers "F.Cu" "B.Cu") (net 2))

)