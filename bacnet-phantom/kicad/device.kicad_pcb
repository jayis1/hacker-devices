(kicad_pcb
  (version 20221018)
  (generator "jayis1 - bacnet-phantom")
  (general (thickness 1.6))
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user)
    (33 "F.Adhes" user)
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user)
    (37 "F.SilkS" user)
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user)
    (41 "Cmts.User" user)
    (42 "Eco1.User" user)
    (43 "Eco2.User" user)
    (44 "Edge.Cuts" user)
    (45 "Margin" user)
    (46 "B.CrtYd" user)
    (47 "F.CrtYd" user)
    (48 "B.Fab" user)
    (49 "F.Fab" user)
  )
  (setup
    (pad_to_mask_clearance 0.05)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plotinvisibletext false)
      (padsonsilk false)
      (subtractmaskfromsilk false)
      (outputformat 1)
      (mirror false)
      (drillshape 0)
      (scaleselection 1)
      (outputdirectory "gerbers/"))
  )
  (net 0 "")
  (net 1 "GND")
  (net 2 "+3V3")
  (net 3 "+5V")
  (net 4 "VBAT")
  (net 5 "VBUS")
  (net 6 "SPI_MOSI")
  (net 7 "SPI_MISO")
  (net 8 "SPI_SCLK")
  (net 9 "W5500_CS")
  (net 10 "W5500_RST")
  (net 11 "W5500_INT")
  (net 12 "MSTP_TX")
  (net 13 "MSTP_RX")
  (net 14 "MSTP_DE")
  (net 15 "MSTP_RE_N")
  (net 16 "OLED_SDA")
  (net 17 "OLED_SCL")
  (net 18 "WP_JUMPER")
  (net 19 "TAMPER")
  (net 20 "LED_R")
  (net 21 "LED_G")
  (net 22 "LED_B")
  (net 23 "CHRG")
  (net 24 "STDBY")
  (net 25 "BATT_DIV")
  (net 26 "RS485_A")
  (net 27 "RS485_B")
  (net 28 "USB_DP")
  (net 29 "USB_DM")

  (gr_text "BACnet Phantom - (c) jayis1 - authorized research only"
    (at 105 105 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))

