  (setup
    (stackup
      (layer "F.Cu" (copper F.Cu) (type copper) (thickness 0.035))
      (layer "dielectric 1" (type core) (thickness 0.2) (material "FR4"))
      (layer "In1.Cu" (copper In1.Cu) (type copper) (thickness 0.035))
